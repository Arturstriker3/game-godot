      "economy_long_run_test",
      "economy_world_test"
    ],
    "agriculture": [
      "agri_calendar_owner_test",
      "agriculture_seasonal_test",
      "pop_needs_test",
      "b6_property_test"
    ],
    "services": [
      "services_test",
      "services_business_audit_test",
      "services_template_test"
    ],
    "energy": [
      "e2e3_power_test",
      "e5_interconnect_test",
      "e6_energy_map_test",
      "e7_tariff_test",
      "f0_fuels_test",
      "renewables_balance_test",
      "fleet_fuel_test"
    ],
    "urban_full": [
      "construction_queue_test",
      "construction_project_test",
      "city_gov_test",
      "urban_land_test",
      "urban_load_test",
