{
  "version": 1,
  "base": "balance/global-resources",
  "description": "Mapa de impacto: caminho alterado -> testes que devem rodar no -Tier quick/pr. Conservador: core central -> conjunto amplo; caminho desconhecido -> broad_economy. Editado a mao; validado por tools/run_tests.ps1 (nomes fora do catalogo geram aviso).",
  "sentinels": {
    "cheap": [
      "economy_save_load_roundtrip_test",
      "c3_bank_seizure_conservation_test",
      "c1_balance_test"
    ],
    "runs": [
      {
        "name": "c1_world_ai_90",
        "script": "res://tools/c1_world_ai_365.gd",
        "args": ["--days=90"],
        "tier": "pr",
        "timeout_s": 1200
      },
      {
        "name": "c1_world_ai_365",
        "script": "res://tools/c1_world_ai_365.gd",
        "args": ["--days=365"],
        "tier": "nightly",
        "timeout_s": 3600
      }
    ]
  },
  "test_sets": {
    "broad_economy": [
      "economy_integration_test",
