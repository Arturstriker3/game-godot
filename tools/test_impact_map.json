    "core_set": [
      "broad_economy",
      "bank_fast",
      "bank_fx_heavy",
      "production",
      "storage_g2_test",
      "construction_project_test",
      "urban_land_test",
      "urban_load_test",
      "housing_market_test",
      "e2e3_power_test",
      "f0_fuels_test",
      "fleet_fuel_test"
    ]
  },
  "default_tests": ["broad_economy"],
  "rules": [
    {
      "match": "^gdextension/src/",
      "tests": ["core_set"],
      "requires_nightly": true,
      "note": "qualquer fonte do nucleo: conjunto amplo de nucleo (core_set); o runner avisa para rodar -Tier nightly antes do merge. ALL fica reservado a infra de teste."
    },
    {
      "match": "^core/economy/(economy_sim|tick_scheduler|turbo_config|command_log|save)[A-Za-z0-9_]*\\.gd$",
      "tests": ["core_set"],
      "requires_nightly": true,
      "note": "fachada/save/agendador: conjunto amplo de nucleo"
    },
    {
      "match": "^core/economy/(bank|central_bank|fx|monetary|exchange|stock)",
      "tests": ["bank_fast", "bank_fx_heavy", "c1_balance_test"]
    },
    {
      "match": "^core/economy/(production|efficien|recipe|balance|byproduct)",
      "tests": ["production", "d127_byproducts_test", "d125_efficiency_test"]
    },
    {
      "match": "^core/economy/agriculture",
      "tests": ["agriculture"]
    },
    {
      "match": "^core/economy/(storage|warehouse)",
      "tests": ["storage_g2_test", "c1_balance_test"]
    },
    {
      "match": "^core/economy/services?",
      "tests": ["services"]
    },
    {
      "match": "^core/economy/(power|energy|fuel|refining)",
      "tests": ["energy"]
    },
    {
      "match": "^core/economy/(urban|housing|property|construction|city_gov|land)",
      "tests": ["urban_full"]
    },
    {
      "match": "^core/economy/(labor|population|demography|migration|strata|informality|region)",
      "tests": ["population_full"]
    },
    {
      "match": "^core/economy/geography",
      "tests": ["broad_economy", "economy_city_catchment_test", "economy_deposit_ownership_test", "population_age_test"]
    },
    {
      "match": "^core/economy/",
      "tests": ["broad_economy"]
    },
    {
      "match": "^data/definitions/economy/(recipes|goods|production|byproducts)",
      "tests": ["production", "d127_byproducts_test", "d125_efficiency_test"]
    },
    {
      "match": "^data/definitions/economy/",
      "tests": ["broad_economy"]
    },
    {
      "match": "^data/definitions/(scenario|natural)/",
      "tests": ["world_data"]
    },
    {
      "match": "^data/definitions/population/",
      "tests": ["population_age_test", "population_demo_test", "pop_needs_test", "b7_informality_test"]
    },
    {
      "match": "^data/definitions/energy/",
      "tests": ["energy"]
    },
    {
      "match": "^data/definitions/agriculture/",
      "tests": ["agriculture"]
    },
    {
      "match": "^data/definitions/(i18n|culture)/",
      "tests": ["goods_data_test", "culture_db_test", "business_name_test", "population_template_test", "services_template_test"]
    },
    {
      "match": "^core/ui/",
      "tests": ["ui"]
    },
    {
      "match": "^ui/",
      "tests": ["ui"]
    },
    {
      "match": "^map/",
      "tests": ["map"]
    },
    {
      "match": "^game/",
      "tests": ["game"]
    },
    {
      "match": "^gdextension/economy\\.gdextension$",
      "tests": ["core_set"],
      "requires_nightly": true
    },
    {
      "match": "^project\\.godot$",
      "tests": ["core_set"],
      "requires_nightly": true
    },
    {
      "match": "^(docs/|\\.md$|[A-Za-z0-9_./-]+\\.md$)",
      "tests": [],
      "note": "documentacao: so as sentinelas"
    },
    {
      "match": "^(tools/run_tests\\.ps1|tools/test_impact_map\\.json|tools/tmp_paths\\.gd)$",
      "tests": ["ALL"],
      "note": "infra de testes alterada: a propria selecao deixa de ser confiavel, roda a bateria inteira (equivale a -All)"
    },
    {
      "match": "^tools/",
      "tests": [],
      "note": "ferramenta/teste: o proprio teste e selecionado pelo nome; helper puro roda so as sentinelas"
    }
  ],
  "cli_checks": [
    {
      "name": "sim_unit_tests",
      "command": "gdextension/build-unit-tests/sim_unit_tests.exe",
      "args": [],
      "tier": "quick",
      "timeout_s": 60,
      "fail_fast": true,
      "requires": ["gdextension/build-unit-tests/sim_unit_tests.exe"],
      "note": "FASE 2: testes unitarios C++ do nucleo (sem Godot, <1 s). Roda em TODO -Tier quick/pr e falha rapido; se o executavel nao estiver compilado (cmake -DOPENGS_BUILD_UNIT_TESTS=ON), vira SKIP. Qualquer gdextension/src/** mapeia para este alvo SEMPRE (nao depende do diff). Como compilar: docs/testing/cpp_unit_tests.md."
    }
  ]
}
