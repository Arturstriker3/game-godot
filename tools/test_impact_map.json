      "c2c_real_fx_test",
      "c2c_p1_fx_passthrough_test",
      "c3_bank_credit_test",
      "c3_group_balance_test",
      "c3_bank_seizure_conservation_test",
      "c4_banks_test",
      "c5_stock_exchange_test",
      "c6_bank_crisis_test",
      "currency_trade_test"
    ],
    "bank_fx_heavy": [
      "c2b2_fx_stress_test"
    ],
    "production": [
      "production_chain_test",
      "d125_efficiency_test",
