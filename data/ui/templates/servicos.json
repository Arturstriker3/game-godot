                          "slot": "services.filter.hospitality_tourism"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.freight_logistics",
                          "slot": "services.filter.freight_logistics"
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "gap": 6,
                      "blocks": [
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.passenger_transport",
                          "slot": "services.filter.passenger_transport"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.finance",
                          "slot": "services.filter.finance"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.insurance_pension",
                          "slot": "services.filter.insurance_pension"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.health",
                          "slot": "services.filter.health"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.education",
                          "slot": "services.filter.education"
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "gap": 6,
                      "blocks": [
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.telecom",
                          "slot": "services.filter.telecom"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.it",
                          "slot": "services.filter.it"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.media_advertising",
                          "slot": "services.filter.media_advertising"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.professional_services",
                          "slot": "services.filter.professional_services"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.real_estate",
                          "slot": "services.filter.real_estate"
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "gap": 6,
                      "blocks": [
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.construction",
                          "slot": "services.filter.construction"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.maintenance_repair",
                          "slot": "services.filter.maintenance_repair"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.personal_services",
                          "slot": "services.filter.personal_services"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.leisure_culture",
                          "slot": "services.filter.leisure_culture"
                        },
                        {
                          "type": "chip_filter",
                          "text": "@services.sector.cleaning_security_waste",
                          "slot": "services.filter.cleaning_security_waste"
                        }
                      ]
                    },
                    {
                      "type": "data_table",
                      "slot": "services.businesses",
                      "grow": true,
                      "fill_height": true,
                      "selected": 0,
                      "page_size": 8,
                      "sort_col": 5,
                      "descending": true,
                      "footer_left": "@services.businesses.footer",
                      "columns": [
                        {
                          "label": "@services.col.business",
                          "weight": 2.9,
                          "align": "left"
                        },
                        {
                          "label": "@services.col.sector",
                          "weight": 0.95,
                          "align": "left"
                        },
                        {
                          "label": "@services.col.city",
                          "weight": 1.3,
                          "align": "left"
                        },
                        {
                          "label": "@services.col.culture",
                          "weight": 0.95,
                          "align": "left"
                        },
                        {
                          "label": "@services.col.employees",
                          "weight": 0.8,
                          "align": "right"
                        },
                        {
                          "label": "@services.col.profit",
                          "weight": 0.95,
                          "align": "right"
                        },
                        {
                          "label": "@services.col.status",
                          "weight": 0.85,
                          "align": "left"
                        }
                      ],
                      "rows": []
                    },
                    {
                      "type": "note_card",
                      "slot": "services.businesses.empty",
                      "hidden": true,
                      "title": "@services.businesses.empty.title",
                      "body": "@services.businesses.empty.body",
                      "width": 560
                    },
                    {
                      "type": "label",
                      "text": "@services.businesses.hint",
                      "font": "typed",
                      "size": 12,
                      "tone": "suave",
                      "wrap": true,
                      "wrap_width": 700,
                      "slot": "services.businesses.hint"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
